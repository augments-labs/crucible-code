# Local-only process docs (briefs, decisions, specs, designs, plans).
# Never referenced from production code, docs, or CI.
.sdlc-skills/

# A contributor's own scratch space, per checkout. Nothing here is part of the
# program, and a stray file under it is one an `add -A` would otherwise commit.
.tmp/

# Per-machine Claude Code settings. The committed .claude/ holds skills, which
# are shared; anything ending in .local.json is one contributor's own.
.claude/settings.local.json

# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# One contributor's JetBrains IDE settings, per machine and per checkout.
.idea/

# insta writes a rejected picture beside the accepted one. It is the diff you
# are being asked about, never something to commit.
*.snap.new

# The candidate an agreement gate formats before comparing it to the file it is
# holding to account. It is renamed over that file or removed in the same test,
# so one left behind is one a run did not finish.
**/*.rs.new
