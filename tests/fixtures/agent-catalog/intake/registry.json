      "id": "fake-agent",
      "name": "Fake Agent",
      "version": "1.0.0",
      "description": "Every way a binary target is kept or dropped.",
      "license": "MIT",
      "distribution": {
        "binary": {
          "linux-x86_64": {
            "archive": "https://downloads.fake.example/fake-1.0.0-linux-x86_64.tar.gz",
            "sha256": "c7e21ddbb8a8103f2becf67dbbf1394fd0e4ea6f592930f1306a705a94aa71dc",
            "cmd": "./agent",
            "args": ["acp", "--no-color"],
            "env": {"FAKE_NO_UPDATE": "1"}
          },
          "darwin-aarch64": {
            "archive": "https://downloads.fake.example/fake-1.0.0-darwin-aarch64.zip",
            "cmd": "./agent",
            "args": ["acp"]
          },
