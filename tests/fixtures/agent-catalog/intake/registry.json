            "cmd": "./agent",
            "args": ["acp"]
          },
          "windows-x86_64": {
            "archive": "https://downloads.fake.example/fake-1.0.0-windows-x86_64.zip",
            "cmd": "agent.exe",
            "args": ["acp"]
          },
          "linux-aarch64": {
            "archive": "https://downloads.fake.example/fake-1.0.0-linux-aarch64.tar.gz",
            "cmd": "./agent",
            "args": ["acp"],
